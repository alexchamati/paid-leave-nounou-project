<%= form_with model: contract, local: true do |f| %>
  <div class="start_date-container">
    <%= f.label :start_date, "Date de début de contrat" %>
    <div>
      <%= f.date_field :start_date,
        pattern: "(0[1-9]|[12][0-9]|3[01])\/(0[1-9]|1[0,1,2])\/(19|20)\d{2}",
        required: true,
        value: contract.start_date,
        # disabled keyboard, selection only
        onkeydown: "return false;",
        onpaste: "return false;",
        autocomplete: "off"
      %>
    </div>
    <% if contract.errors[:start_date].any? %>
      <div id="start_date-error-message"><%= contract.errors[:start_date].first %></div>
    <% end %>
  </div>

  <div class="end_date-container">
    <%= f.label :end_date, "Date de fin de contrat" %>
    <div>
      <%= f.date_field :end_date,
        pattern: "(0[1-9]|[12][0-9]|3[01])\/(0[1-9]|1[0,1,2])\/(19|20)\d{2}",
        required: true,
        value: contract.end_date,
        # disabled keyboard, selection only
        onkeydown: "return false;",
        onpaste: "return false;",
        autocomplete: "off"
      %>
    </div>
    <% if contract.errors[:end_date].any? %>
      <div id="end_date-error-message"><%= contract.errors[:end_date].first %></div>
    <% end %>
  </div>

  <div class="salary-container">
    <%= f.label :salary, "Salaire brut mensuel €" %>
    <%= f.number_field :salary,
          min: CONTRACT_CONFIG[:salary][:min],
          max: CONTRACT_CONFIG[:salary][:max],
          step: 1,
          required: true,
          value: contract.salary,
          placeholder: "Entrez un salaire entre #{CONTRACT_CONFIG[:salary][:min]} et #{CONTRACT_CONFIG[:salary][:max]} €" %>
    <% if contract.errors[:salary].any? %>
      <div id="salary-error-message"><%= contract.errors[:salary].first %></div>
    <% end %>
  </div>

  <div class="submit-container">
    <%= f.submit "Créer le contrat" %>
  </div>
<% end %>