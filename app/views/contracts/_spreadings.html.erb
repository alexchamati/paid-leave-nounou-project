<div class="spreadings-container">
  <table class="table-spreadings">
    <thead>
      <tr>
        <th>Mois</th>
        <th class="text-right">Salaire Brut</th>
        <th class="text-right">CP Intégral (Juin)</th>
        <th class="text-right">CP 12ème</th>
        <th class="text-right">CP 10% Mensuel</th>
        <th class="text-right">CP 10% Régul.</th>
        <th class="text-right">CP 10% Total</th>
      </tr>
    </thead>
    <tbody>
      <% spreadings.each do |spreading| %>
        <tr>
          <td class="dates">
            <%= spreading[:number_work_day_of_month_date]&.strftime("%m/%Y") || "—" %>
          </td>
          <td class="text-right highlight-salary">
            <%= number_to_currency(spreading[:salary], locale: :fr) %>
          </td>
          <td class="text-right">
            <%= spreading[:paid_leave_full_june] ? number_to_currency(spreading[:paid_leave_full_june], locale: :fr) : "-" %>
          </td>
          <td class="text-right">
            <%= spreading[:paid_leave_twelfth] ? number_to_currency(spreading[:paid_leave_twelfth], locale: :fr) : "-" %>
          </td>
          <td class="text-right">
            <%= spreading[:paid_leave_10_percent_monthly] ? number_to_currency(spreading[:paid_leave_10_percent_monthly], locale: :fr) : "-" %>
          </td>
          <td class="text-right">
            <%= spreading[:paid_leave_10_percent_regularization] ? number_to_currency(spreading[:paid_leave_10_percent_regularization], locale: :fr) : "-" %>
          </td>
          <td class="text-right final-total">
            <%= spreading[:paid_leave_10_percent_total] ? number_to_currency(spreading[:paid_leave_10_percent_total], locale: :fr) : "-" %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td class="dates">TOTAL</td>
        <td class="text-right highlight-salary">
          <%= number_to_currency(spreadings.sum { |s| s[:salary] || 0 }, locale: :fr) %>
        </td>
        <td class="text-right">
          <%= number_to_currency(spreadings.sum { |s| s[:paid_leave_full_june] || 0 }, locale: :fr) %>
        </td>
        <td class="text-right">
          <%= number_to_currency(spreadings.sum { |s| s[:paid_leave_twelfth] || 0 }, locale: :fr) %>
        </td>
        <td class="text-right"></td>
        <td class="text-right"></td>
        <td class="text-right final-total">
          <%= number_to_currency(spreadings.sum { |s| s[:paid_leave_10_percent_total] || 0 }, locale: :fr) %>
        </td>
    </tfoot>
  </table>
</div>

<style>
  .spreadings-container {
    margin: 20px 0;
    overflow-x: auto;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
  }
  .table-spreadings {
    width: 100%;
    border-collapse: collapse;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
  }
  .table-spreadings th {
    background: #f4f7f6;
    color: #444;
    padding: 10px;
    border-bottom: 2px solid #ddd;
    font-weight: 600;
  }
  .table-spreadings td {
    padding: 8px 10px;
    border-bottom: 1px solid #eee;
  }
  .table-spreadings tfoot tr {
    background-color: #fafafa;
    border-top: 2px solid #bbb;
    font-weight: bold;
  }
  .text-right { text-align: right; }
  .dates { font-weight: 500; color: #2c3e50; text-transform: capitalize; }
  .highlight-salary { color: #2980b9; font-weight: 600; }
  .final-total { font-weight: bold; color: #27ae60; }
  
  .table-spreadings td:empty::before { content: "-"; color: #ccc; }
</style>